# ==================================
#         DATABASE (MySQL)
# ==================================
# DB 연결을 위한 전체 URL. 형식: jdbc:mysql://{호스트}:{포트}/{데이터베이스명}
spring.datasource.url=jdbc:mysql:
# DB 접속용 사용자 이름
spring.datasource.username=
# DB 접속용 비밀번호
spring.datasource.password=
# MySQL 8 이상을 위한 JDBC 드라이버 클래스
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver


# ==================================
#           JPA & HIBERNATE
# ==================================
# true로 설정 시, 실행되는 SQL 쿼리를 콘솔에 출력합니다. (디버깅용)
spring.jpa.properties.hibernate.show_sql=true
# DDL(Data Definition Language) 자동 생성 전략
# create: 실행 시마다 스키마를 새로 생성 (기존 데이터 삭제)
# update: 변경된 스키마만 반영 (데이터 유지)
# validate: 스키마 변경점 검증
# none: 자동 생성 안 함
spring.jpa.hibernate.ddl-auto=update


# ==================================
#           SECURITY (JWT)
# ==================================
# JWT 토큰을 서명하고 검증하기 위한 시크릿 키. 길고 복잡한 문자열을 사용하세요.
jwt.secret=your-super-secret-key-that-is-long-and-secure

# 위치 인증 거리(2000미터)
location.auth.max-distance-meters=2000

# ==================================
#            EXTERNAL APIS
# ==================================
# 한국관광공사 TourAPI 서비스 인증키
tourapi.key=your-tourapi-service-key


# Azure OpenAI 서비스 엔드포인트 URL
azure.openai.endpoint=your-azure-openai-endpoint
# Azure OpenAI 서비스 API 키
azure.openai.api-key=your-azure-openai-api-key
# Azure OpenAI 배포 모델명
azure.openai.deployment=gpt-4o-mini
# Azure OpenAI API 버전
azure.openai.api-version=2025-01-01-preview
# Azure Storage 연결 문자열 (Azure Portal에서 확인 가능)
azure.storage.connection-string=your-azure-storage-connection-string

# Kakao Developers에서 발급받은 REST API 키
kakao.api-key=your-kakao-rest-api-key

# Google AI Studio에서 발급받은 Gemini API 키
gemini.api.key=your-gemini-api-key